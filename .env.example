# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Media Server (public CF tunnel for video files)
MEDIA_SERVER_URL=https://media.4voice.ai

# App mode: true = commercial, false = private/local-videos behavior
NEXT_PUBLIC_COMMERCIAL_MODE=true

# Server
PORT=3000
NODE_ENV=production

# Cloudflare Tunnel for https://kara2.4voice.ai
# Deploy cloudflared/credentials.json next to cloudflared/config.yml on the LXC
# (credentials are gitignored; create via: cloudflared tunnel create / tunnel token)
# Optional: TUNNEL_TOKEN=  # only if switching compose to token-based remote config
